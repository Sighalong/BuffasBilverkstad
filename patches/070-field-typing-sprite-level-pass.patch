From b0b794734eb3656f21c4e3f29136d48b84def02a Mon Sep 17 00:00:00 2001
From: Sighalong <noreply@example.invalid>
Date: Sat, 17 Oct 2026 21:21:10 +0200
Subject: [PATCH] director: a frame/movie keyDown that doesn't pass no longer
 eats typing into an editable field

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 engines/director/lingo/lingo-events.cpp | 13 +++++++++++++
 engines/director/lingo/lingo.cpp        |  1 +
 engines/director/lingo/lingo.h          |  1 +
 3 files changed, 15 insertions(+)

diff --git a/engines/director/lingo/lingo-events.cpp b/engines/director/lingo/lingo-events.cpp
index c8a0be8..5cf05e5 100644
--- a/engines/director/lingo/lingo-events.cpp
+++ b/engines/director/lingo/lingo-events.cpp
@@ -743,6 +743,14 @@ bool Movie::processInputEvent(LEvent event, int targetId, Common::Point pos) {
 	// Try and process input events now
 	_vm->setCurrentWindow(this->getWindow());
 	_lingo->processEvents(_inputEventQueue, true);
+	// Typing into an editable field is the field's (sprite/cast) handlers' call:
+	// a frame or movie keyDown that doesn't pass doesn't eat the character
+	// (Mulle Meck 06: the movie keyDown runs systemKeys without pass).
+	if ((event == kEventKeyDown || event == kEventKeyUp) && targetId) {
+		Channel *ch = _score->getChannelById(targetId);
+		if (ch && ch->_widget && ch->_widget->isEditable())
+			return !_lingo->_keyStoppedBySprite;
+	}
 	return _lingo->_passEvent;
 }
 
@@ -780,6 +788,8 @@ void Lingo::processEvents(Common::Queue<LingoEvent> &queue, bool isInputEvent) {
 	Score *sc = movie->getScore();
 
 	bool behavioursCompleted = false;
+	if (isInputEvent)
+		_keyStoppedBySprite = false;
 
 	while (!queue.empty()) {
 		LingoEvent el = queue.pop();
@@ -817,6 +827,9 @@ void Lingo::processEvents(Common::Queue<LingoEvent> &queue, bool isInputEvent) {
 			_eventHandlerTypes[el.event], scriptType2str(el.scriptType), el.scriptId.asString().c_str(), el.channelId
 		);
 		bool completed = processEvent(el.event, el.scriptType, el.scriptId, el.channelId, el.scriptInstance);
+		if (isInputEvent && (el.event == kEventKeyDown || el.event == kEventKeyUp) &&
+				(el.scriptType == kScoreScript || el.scriptType == kCastScript) && !el.passByDefault && !_passEvent)
+			_keyStoppedBySprite = true;
 		movie->_lastEventId[el.event] = el.eventId;
 
 		if (_vm->getVersion() >= 600) {
diff --git a/engines/director/lingo/lingo.cpp b/engines/director/lingo/lingo.cpp
index 19cb221..6c9532e 100644
--- a/engines/director/lingo/lingo.cpp
+++ b/engines/director/lingo/lingo.cpp
@@ -211,6 +211,7 @@ Lingo::Lingo(DirectorEngine *vm) : _vm(vm) {
 
 	// events
 	_passEvent = false;
+	_keyStoppedBySprite = false;
 	_perFrameHook = Datum();
 
 	_windowList.type = ARRAY;
diff --git a/engines/director/lingo/lingo.h b/engines/director/lingo/lingo.h
index d80362d..6ce2198 100644
--- a/engines/director/lingo/lingo.h
+++ b/engines/director/lingo/lingo.h
@@ -580,6 +580,7 @@ public:
 
 	// events
 	bool _passEvent;
+	bool _keyStoppedBySprite; // a sprite/cast keyDown handler didn't pass: no typing into the field
 	Datum _perFrameHook;
 
 	Datum _windowList;
-- 
