From 6083a75e0e8f0fea2583961ae0edb6dfdd24245e Mon Sep 17 00:00:00 2001
From: Sighalong <noreply@example.invalid>
Date: Sat, 17 Oct 2026 15:33:43 +0200
Subject: [PATCH] director: don't let go-to-current-frame cancel a pending jump

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 engines/director/lingo/lingo-funcs.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/engines/director/lingo/lingo-funcs.cpp b/engines/director/lingo/lingo-funcs.cpp
index 0d96044..4c78edf 100644
--- a/engines/director/lingo/lingo-funcs.cpp
+++ b/engines/director/lingo/lingo-funcs.cpp
@@ -104,6 +104,16 @@ void Lingo::func_goto(Datum &frame, Datum &movie, bool calledfromgo) {
 		return;
 	}
 
+	// A frame script's `go the frame` runs after the sprite behaviors' exitFrame.
+	// If a behavior already queued a jump (Mulle Meck 94.DXR: the judge's
+	// SpriteAnim does go(#next) when its speech ends), Director takes that jump;
+	// don't let the loop cancel it.
+	if (frame.type == INT && frame.asInt() == score->getCurrentFrameNum() &&
+			score->getNextFrame() != 0 && score->getNextFrame() != score->getCurrentFrameNum()) {
+		MDIAG(2, "go", "keep pending jump to frame %d over go to current frame %d", score->getNextFrame(), frame.asInt());
+		return;
+	}
+
 	// `go the frame` loops are routine; only log real jumps
 	if (!(frame.type == INT && frame.asInt() == score->getCurrentFrameNum()))
 	MDIAG(1, "go", "frame %s from frame %d", frame.asString().c_str(), score->getCurrentFrameNum());
