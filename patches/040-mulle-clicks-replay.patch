From 87e80cbdf9646631c1f07258a1b6dbe919d23119 Mon Sep 17 00:00:00 2001
From: Sighalong <noreply@example.invalid>
Date: Sat, 17 Oct 2026 15:00:48 +0200
Subject: [PATCH] 0037 MULLE_CLICKS scripted input replay in
 DirectorEngine::pollEvent (diagnostics)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 engines/director/events.cpp | 107 ++++++++++++++++++++++++++++++++++++
 1 file changed, 107 insertions(+)

diff --git a/engines/director/events.cpp b/engines/director/events.cpp
index 74fcfef..6aee815 100644
--- a/engines/director/events.cpp
+++ b/engines/director/events.cpp
@@ -19,7 +19,10 @@
  *
  */
 
+#define FORBIDDEN_SYMBOL_EXCEPTION_getenv
+
 #include "common/events.h"
+#include "common/tokenizer.h"
 #include "common/keyboard.h"
 #include "common/system.h"
 #include "common/translation.h"
@@ -44,12 +47,116 @@ namespace Director {
 
 int DirectorEngine::getMacTicks() { return (int)(g_system->getMillis() * 60 / 1000.) - _tickBaseline; }
 
+// Scripted input for unattended smoke tests: env MULLE_CLICKS="[@movie ]x,y,delayMs[,r];[@movie ]key:enter|<char>,delayMs;..."
+// A step waits delayMs after the previous step finished, or after the current movie's name starts with "movie".
+struct ReplayStep {
+	Common::String movie;
+	int x, y, key;
+	uint32 delay;
+	bool right;
+};
+
+static bool replayPoll(Common::Event &event) {
+	static bool parsed = false;
+	static Common::Array<ReplayStep> steps;
+	static uint idx = 0;
+	static int phase = 0;
+	static bool armed = false;
+	static uint32 armedAt = 0, nextAt = 0;
+
+	if (!parsed) {
+		parsed = true;
+		const char *env = getenv("MULLE_CLICKS");
+		Common::StringTokenizer tok(env ? env : "", ";");
+		while (!tok.empty()) {
+			Common::String t = tok.nextToken();
+			t.trim();
+			ReplayStep st = {"", 0, 0, 0, 0, false};
+			if (t.hasPrefix("@")) {
+				uint sp = t.find(' ');
+				st.movie = t.substr(1, sp == Common::String::npos ? sp : sp - 1);
+				t = sp == Common::String::npos ? "" : t.substr(sp + 1);
+			}
+			Common::Array<Common::String> p;
+			Common::StringTokenizer ft(t, ",");
+			while (!ft.empty())
+				p.push_back(ft.nextToken());
+			if (p.size() >= 2 && p[0].hasPrefix("key:") && !p[0].substr(4).empty()) {
+				Common::String k = p[0].substr(4);
+				st.key = k.equalsIgnoreCase("enter") ? 13 : (byte)k[0];
+				st.x = -1;
+				st.delay = p[1].asUint64();
+			} else if (p.size() >= 3) {
+				st.x = p[0].asUint64();
+				st.y = p[1].asUint64();
+				st.delay = p[2].asUint64();
+				st.right = p.size() > 3 && p[3].equalsIgnoreCase("r");
+			} else {
+				continue;
+			}
+			steps.push_back(st);
+		}
+		if (!steps.empty())
+			MDIAG(1, "replay", "%d steps armed", (int)steps.size());
+	}
+	if (idx >= steps.size())
+		return false;
+
+	ReplayStep &s = steps[idx];
+	uint32 now = g_system->getMillis();
+	if (phase == 0) {
+		if (!armed) {
+			Movie *m = g_director->getCurrentMovie();
+			if (!s.movie.empty() && (!m || !m->getMacName().hasPrefixIgnoreCase(s.movie)))
+				return false;
+			armed = true;
+			armedAt = now;
+		}
+		if (now - armedAt < s.delay)
+			return false;
+	} else if (now < nextAt) {
+		return false;
+	}
+
+	bool isKey = s.x < 0;
+	bool done = false;
+	if (isKey) {
+		event.type = phase == 0 ? Common::EVENT_KEYDOWN : Common::EVENT_KEYUP;
+		event.kbd.ascii = s.key;
+		event.kbd.keycode = s.key == 13 ? Common::KEYCODE_RETURN : (Common::KeyCode)((s.key >= 'A' && s.key <= 'Z') ? s.key + 32 : s.key);
+		event.kbd.flags = 0;
+		done = phase == 1;
+	} else if (phase == 0) {
+		event.type = Common::EVENT_MOUSEMOVE;
+		g_system->warpMouse(s.x, s.y);
+	} else {
+		event.type = phase == 1 ? (s.right ? Common::EVENT_RBUTTONDOWN : Common::EVENT_LBUTTONDOWN) : (s.right ? Common::EVENT_RBUTTONUP : Common::EVENT_LBUTTONUP);
+		done = phase == 2;
+	}
+	if (!isKey) {
+		event.mouse = Common::Point(s.x, s.y);
+	}
+	if (phase == 0)
+		MDIAG(1, "replay", "step %d/%d %s %d,%d key %d (movie '%s')", (int)idx + 1, (int)steps.size(), isKey ? "key" : "click", s.x, s.y, s.key, g_director->getCurrentMovie() ? g_director->getCurrentMovie()->getMacName().c_str() : "?");
+	nextAt = now + (isKey ? 40 : 70);
+	if (done) {
+		idx++;
+		phase = 0;
+		armed = false;
+	} else {
+		phase++;
+	}
+	return true;
+}
+
 bool DirectorEngine::pollEvent(Common::Event &event) {
 	// used by UnitTest XObject
 	if (!_injectedEvents.empty()) {
 		event = _injectedEvents.remove_at(0);
 		return true;
 	}
+	if (replayPoll(event))
+		return true;
 	return g_system->getEventManager()->pollEvent(event);
 }
 
