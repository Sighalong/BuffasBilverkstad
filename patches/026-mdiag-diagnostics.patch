diff --git a/engines/director/mullediag.cpp b/engines/director/mullediag.cpp
new file mode 100644
index 0000000..e5ea4b3
--- /dev/null
+++ b/engines/director/mullediag.cpp
@@ -0,0 +1,22 @@
+#include "common/config-manager.h"
+#include "common/system.h"
+#include "director/mullediag.h"
+
+namespace Director {
+
+int mdiagLevel() {
+	static int level = -1;
+	if (level < 0)
+		level = ConfMan.hasKey("mdiag") ? ConfMan.getInt("mdiag") : 1;
+	return level;
+}
+
+void mdiagPrint(const char *area, const char *fmt, ...) {
+	va_list va;
+	va_start(va, fmt);
+	Common::String msg = Common::String::vformat(fmt, va);
+	va_end(va);
+	warning("MDIAG %u %s: %s", g_system->getMillis(), area, msg.c_str());
+}
+
+} // End of namespace Director
diff --git a/engines/director/mullediag.h b/engines/director/mullediag.h
new file mode 100644
index 0000000..1b36337
--- /dev/null
+++ b/engines/director/mullediag.h
@@ -0,0 +1,18 @@
+/* Mulle Meck diagnostics: one-line, level-gated "MDIAG <area>:" log lines.
+ * ConfMan key "mdiag" in scummvm.ini [scummvm]: 0 = off, 1 = events (default), 2 = + hover/cursor/frame detail. */
+#ifndef DIRECTOR_MULLEDIAG_H
+#define DIRECTOR_MULLEDIAG_H
+
+#include "common/scummsys.h"
+
+namespace Director {
+
+int mdiagLevel();
+void mdiagPrint(const char *area, const char *fmt, ...) GCC_PRINTF(2, 3);
+
+#define MDIAG(level, area, ...) \
+	do { if (Director::mdiagLevel() >= (level)) Director::mdiagPrint(area, __VA_ARGS__); } while (0)
+
+} // End of namespace Director
+
+#endif
