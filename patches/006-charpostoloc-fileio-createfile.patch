diff --git a/engines/director/lingo/xlibs/f/fileio.cpp b/engines/director/lingo/xlibs/f/fileio.cpp
index 76a2ccc..5c7acaa 100644
--- a/engines/director/lingo/xlibs/f/fileio.cpp
+++ b/engines/director/lingo/xlibs/f/fileio.cpp
@@ -419,8 +419,31 @@ void FileIO::m_closeFile(int nargs) {
 	me->clear();
 }
 
-// FIXME: split out filename-to-savegame logic from open() so we can implement createFile
-XOBJSTUB(FileIO::m_createFile, 0)
+void FileIO::m_createFile(int nargs) {
+	FileObject *me = static_cast<FileObject *>(g_lingo->_state->me.u.obj);
+	Datum d = g_lingo->pop();
+	Common::String path = d.asString();
+
+	// Same filename-to-savegame mapping as FileObject::open()
+	if (!path.hasSuffixIgnoreCase(".txt"))
+		path += ".txt";
+	Common::String filename = lastPathComponent(path, g_director->_dirSeparator);
+	Common::String prefix = savePrefix();
+	if (!filename.hasPrefixIgnoreCase(prefix))
+		filename = prefix + filename;
+
+	FileIOError err = kErrorNone;
+	Common::OutSaveFile *outFile = g_system->getSavefileManager()->openForSaving(filename, false);
+	if (outFile) {
+		outFile->finalize();
+		delete outFile;
+		((SavedArchive *)SearchMan.getArchive(kSavedFilesArchive))->_addFile(filename);
+	} else {
+		err = kErrorIO;
+	}
+	me->_lastError = err;
+	g_lingo->push(Datum(err));
+}
 
 void FileIO::m_displayOpen(int nargs) {
 	g_lingo->push(getFileNameFromModal(false, Common::String(), Common::String(), "txt"));
