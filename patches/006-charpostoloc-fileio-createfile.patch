+++ b/engines/director/castmember/text.cpp
@@ -436,6 +436,30 @@ int TextCastMember::getLineCount() {
 	return 0;
 }
 
+Common::Point TextCastMember::getCharLoc(int pos) {
+	Common::U32String text = getText();
+	int len = text.size();
+	pos = CLIP(pos, 1, len + 1);
+
+	Graphics::MacFont macFont(_fontId, _fontSize, _textSlant);
+	const Graphics::Font *font = g_director->_wm->_fontMan->getFont(&macFont);
+	if (!font)
+		return Common::Point(0, 0);
+
+	// Walk to the line holding the character; wrapped lines are not modelled
+	int y = 0;
+	int lineStart = 0;
+	int lineHeight = font->getFontHeight();
+	for (int i = 0; i < pos - 1; i++) {
+		if (text[i] == '\r' || text[i] == '\n') {
+			y += lineHeight;
+			lineStart = i + 1;
+		}
+	}
+	int x = lineStart < pos - 1 ? font->getStringWidth(text.substr(lineStart, pos - 1 - lineStart)) : 0;
+	return Common::Point(x, y);
+}
+
 int TextCastMember::getLineHeight(int line) {
 	Graphics::MacText *target = getWidget();
 	if (target) {
