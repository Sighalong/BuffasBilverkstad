-	Datum res(Common::Point(0, 0));
-	g_lingo->push(res);
+	ARGNUMCHECK(2);
+	Datum pos = g_lingo->pop();
+	Datum castRef = g_lingo->pop();
+	Common::Point loc(0, 0);
