+void LB::b_new(int nargs) {
+	// new(#type, castLib x) or new(#type, member n of castLib x) creates an
+	// empty cast member. We clone an existing member of that type instead;
+	// callers like Mulle Meck's copyMember replace its media right away.
+	Datum where;
+	if (nargs > 2)
+		g_lingo->dropStack(nargs - 2);
+	if (nargs >= 2)
+		where = g_lingo->pop();
+	Datum type = g_lingo->pop();
+	Datum res;
+
+	if (type.type != SYMBOL) {
+		g_lingo->lingoError("b_new: expected a cast type symbol, got %s", type.type2str());
+		g_lingo->push(res);
+		return;
+	}
+
+	Movie *movie = g_director->getCurrentMovie();
+	Common::String typeName = type.asString();
+	if (typeName.equalsIgnoreCase("field"))
+		typeName = "text";
+
+	int castLib = DEFAULT_CAST_LIB;
+	int target = 0;
+	if (where.type == CASTLIBREF) {
+		castLib = where.u.i;
+	} else if (where.type == CASTREF) {
+		castLib = where.u.cast->castLib;
+		target = where.u.cast->member;
+	}
+
+	if (movie->getCasts()->contains(castLib)) {
+		Cast *targetCast = movie->getCasts()->getVal(castLib);
+		if (!target)
+			target = targetCast->getNextUnusedID();
+
+		// Prefer a template from the target cast, then any other cast
+		CastMemberID source;
+		Common::Array<int> libs;
+		libs.push_back(castLib);
+		for (auto &it : *movie->getCasts())
+			if (it._key != castLib)
+				libs.push_back(it._key);
+		for (uint i = 0; i < libs.size() && !source.member; i++) {
+			Cast *cast = movie->getCasts()->getVal(libs[i]);
+			for (auto &m : *cast->_loadedCast) {
+				if (m._value && m._key != target && typeName.equalsIgnoreCase(castType2str(m._value->_type))) {
+					source = CastMemberID(m._key, libs[i]);
+					break;
+				}
+			}
+		}
+
+		if (source.member && movie->duplicateCastMember(source, CastMemberID(target, castLib)))
+			res = Datum(CastMemberID(target, castLib));
+	}
+
+	if (res.type != CASTREF)
+		warning("b_new: could not create a #%s member in castLib %d", typeName.c_str(), castLib);
+	g_lingo->push(res);
+}
