+// Load the frame requested by a pending "go" right away, so that Lingo
+// running in the same handler sees its sprites and behaviors. The jump stays
+// queued (now to the current frame), so the normal update just re-enters it.
+bool Score::applyPendingJump() {
+	uint16 target = _nextFrame;
+	if (!target || target == _curFrameNumber || target >= getFramesNum())
+		return false;
+
+	bool skipFrameAdvance = _window->_skipFrameAdvance;
+	updateCurrentFrame();
+	_nextFrame = target;
+	_window->_skipFrameAdvance = skipFrameAdvance;
+	return true;
+}
