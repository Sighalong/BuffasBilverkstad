+// D6+: "the foo of sprite n" falls back to the first of the sprite's behaviors
+// that has a property foo (Mulle Meck reads e.g. the dragging of sprite n).
+static AbstractObject *findSpriteBehaviorWithProp(const Datum &sprite, const Common::String &propName) {
+	if (g_director->getVersion() < 600)
+		return nullptr;
+	Movie *movie = g_director->getCurrentMovie();
+	Score *score = movie ? movie->getScore() : nullptr;
+	Channel *channel = score ? score->getChannelById(sprite.u.i) : nullptr;
+	if (!channel)
+		return nullptr;
+	for (uint i = 0; i < channel->_scriptInstanceList.size(); i++) {
+		const Datum &inst = channel->_scriptInstanceList[i];
+		if (inst.type == OBJECT && inst.u.obj->hasProp(propName))
+			return inst.u.obj;
+	}
+	return nullptr;
+}
