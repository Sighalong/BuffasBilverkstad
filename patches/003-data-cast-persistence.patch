diff --git a/engines/director/cast.cpp b/engines/director/cast.cpp
index 2426f2e..212a0df 100644
--- a/engines/director/cast.cpp
+++ b/engines/director/cast.cpp
@@ -22,6 +22,8 @@
 #include "common/config-manager.h"
 #include "common/file.h"
 #include "common/macresman.h"
+#include "common/savefile.h"
+#include "common/system.h"
 #include "common/memstream.h"
 #include "common/substream.h"
 
@@ -55,6 +57,8 @@
 #include "director/castmember/text.h"
 #include "director/castmember/transition.h"
 #include "director/castmember/xtra.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-the.h"
 #include "director/lingo/lingo-codegen.h"
 
 #include "director/lingo/lingodec/context.h"
@@ -955,6 +959,124 @@ void Cast::loadCast() {
 	if (_castArchive->hasResource(MKTAG('S', 'C', 'R', 'F'), -1)) {
 		debugC(4, kDebugLoading, "'SCRF' resource skipped");
 	}
+
+	loadRuntimeData();
+}
+
+static Common::String runtimeDataFileName(const Common::String &castName) {
+	Common::String name = castName;
+	name.toLowercase();
+	return "mulle-" + name + ".sav";
+}
+
+static void writeSaveString(Common::WriteStream *out, const Common::String &s) {
+	out->writeUint32LE(s.size());
+	out->write(s.c_str(), s.size());
+}
+
+static bool readSaveString(Common::ReadStream *in, Common::String &s) {
+	uint32 len = in->readUint32LE();
+	if (in->err() || in->eos() || len > 64 * 1024 * 1024)
+		return false;
+	char *buf = new char[len + 1];
+	uint32 got = in->read(buf, len);
+	buf[got] = 0;
+	s = Common::String(buf, got);
+	delete[] buf;
+	return got == len;
+}
+
+bool Cast::saveRuntimeData() {
+	// Only the game's "data" cast (DATA.CST) is a save database
+	if (!_castName.equalsIgnoreCase("data") || !_loadedCast)
+		return false;
+
+	Common::Array<int> ids;
+	for (auto &it : *_loadedCast) {
+		CastMember *member = it._value;
+		CastMemberInfo *info = getCastMemberInfo(it._key);
+		if (member && member->_type == kCastText && info && !info->name.empty())
+			ids.push_back(it._key);
+	}
+	Common::sort(ids.begin(), ids.end());
+
+	Common::String fileName = runtimeDataFileName(_castName);
+	Common::String tmpName = fileName + ".tmp";
+	Common::OutSaveFile *out = g_system->getSavefileManager()->openForSaving(tmpName, false);
+	if (!out) {
+		warning("Cast::saveRuntimeData(): could not open %s for writing", tmpName.c_str());
+		return false;
+	}
+	out->writeUint32BE(MKTAG('M', 'M', 'S', '1'));
+	out->writeUint32LE(ids.size());
+	for (int id : ids) {
+		out->writeUint32LE(id);
+		writeSaveString(out, getCastMemberInfo(id)->name);
+		writeSaveString(out, _loadedCast->getVal(id)->getField(kTheText).asString());
+	}
+	out->finalize();
+	bool ok = !out->err();
+	delete out;
+	if (ok) {
+		// Replace the old file only after the new one is complete
+		g_system->getSavefileManager()->removeSavefile(fileName);
+		ok = g_system->getSavefileManager()->renameSavefile(tmpName, fileName, false);
+	}
+	if (!ok)
+		warning("Cast::saveRuntimeData(): could not write %s", fileName.c_str());
+	else
+		debugC(1, kDebugSaving, "Cast::saveRuntimeData(): saved %d members to %s", ids.size(), fileName.c_str());
+	return ok;
+}
+
+void Cast::loadRuntimeData() {
+	if (!_castName.equalsIgnoreCase("data") || !_loadedCast)
+		return;
+
+	Common::InSaveFile *in = g_system->getSavefileManager()->openForLoading(runtimeDataFileName(_castName));
+	if (!in)
+		return;
+	if (in->readUint32BE() != MKTAG('M', 'M', 'S', '1')) {
+		warning("Cast::loadRuntimeData(): bad save file magic");
+		delete in;
+		return;
+	}
+	uint32 count = in->readUint32LE();
+	uint32 restored = 0;
+	for (uint32 i = 0; i < count; i++) {
+		int id = in->readUint32LE();
+		Common::String name, text;
+		if (!readSaveString(in, name) || !readSaveString(in, text)) {
+			warning("Cast::loadRuntimeData(): truncated save file");
+			break;
+		}
+		CastMember *member = getCastMemberByNameAndType(name, kCastText);
+		if (!member) {
+			// A member the game created at runtime (e.g. a new player's database)
+			CastMember *source = nullptr;
+			for (auto &it : *_loadedCast) {
+				if (it._value && it._value->_type == kCastText) {
+					source = it._value;
+					break;
+				}
+			}
+			if (!source)
+				continue;
+			if (_loadedCast->contains(id))
+				id = getNextUnusedID();
+			CastMemberInfo info;
+			info.name = name;
+			if (!duplicateCastMember(source, &info, id))
+				continue;
+			member = getCastMember(id);
+		}
+		if (member) {
+			member->setField(kTheText, Datum(text));
+			restored++;
+		}
+	}
+	delete in;
+	debugC(1, kDebugSaving, "Cast::loadRuntimeData(): restored %d of %d members", restored, count);
 }
 
