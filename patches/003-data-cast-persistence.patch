index 0ff9998..5ee3c00 100644
--- a/engines/director/lingo/lingo-builtins.cpp
+++ b/engines/director/lingo/lingo-builtins.cpp
@@ -1830,9 +1830,24 @@ void LB::b_openXlib(int nargs) {
 }
 
 void LB::b_save(int nargs) {
-	g_lingo->printSTUBWithArglist("b_save", nargs);
+	// save(castLib "data") persists the game's text-member database; the
+	// engine reloads it over DATA.CST whenever that cast is loaded.
+	Datum d = g_lingo->pop();
+	if (nargs > 1)
+		g_lingo->dropStack(nargs - 1);
 
-	g_lingo->dropStack(nargs);
+	Movie *movie = g_director->getCurrentMovie();
+	int castLib = -1;
+	if (d.type == CASTLIBREF)
+		castLib = d.u.i;
+	else if (d.type == INT)
+		castLib = d.u.i;
+	else if (d.type == STRING)
+		castLib = movie->getCastLibIDByName(d.asString());
+	if (movie && movie->getCasts()->contains(castLib))
+		movie->getCasts()->getVal(castLib)->saveRuntimeData();
+	else
+		warning("b_save: unsupported argument %s", d.asString(true).c_str());
 }
 
 void LB::b_saveMovie(int nargs) {
