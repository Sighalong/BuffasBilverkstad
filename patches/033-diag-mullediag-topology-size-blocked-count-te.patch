From b720c4acc5be933e327f835e8e0d3d0ac844c902 Mon Sep 17 00:00:00 2001
From: Sighalong <noreply@example.invalid>
Date: Sat, 17 Oct 2026 14:53:01 +0200
Subject: [PATCH] diag: MULLEDIAG topology size/blocked count - temporary

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 engines/director/castmember/text.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/engines/director/castmember/text.cpp b/engines/director/castmember/text.cpp
index 37bc3c9..2910291 100644
--- a/engines/director/castmember/text.cpp
+++ b/engines/director/castmember/text.cpp
@@ -743,6 +743,16 @@ Datum TextCastMember::getField(int field) {
 				updateFromWidget(widget, true);
 		}
 		d = getText().encode(Common::kUtf8);
+		{
+			CastMemberInfo *ci = _cast->getCastMemberInfo(_castId);
+			if (ci && ci->name.hasPrefix("30t")) {
+				uint blocked = 0;
+				for (uint i = 0; i < _ptext.size(); i++)
+					if (charToNum(_ptext[i]) >= 240)
+						blocked++;
+				warning("MULLEDIAG topology '%s' chars %u blocked %u", ci->name.c_str(), _ptext.size(), blocked);
+			}
+		}
 		break;
 	case kTheTextAlign:
 		d.type = STRING;
-- 
