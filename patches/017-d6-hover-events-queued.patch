From 7effa8a51496757c935307088369ea348fd33da1 Mon Sep 17 00:00:00 2001
From: Sighalong <noreply@example.invalid>
Date: Sat, 17 Oct 2026 14:09:48 +0200
Subject: [PATCH] 0017 D6 mouseEnter/Leave from mouse moves go through the
 input queue (no nested Lingo); log D6 wait tempos

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 engines/director/events.cpp | 9 ++++++---
 engines/director/score.cpp  | 2 ++
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/engines/director/events.cpp b/engines/director/events.cpp
index fb6a7eb..1eae7f9 100644
--- a/engines/director/events.cpp
+++ b/engines/director/events.cpp
@@ -232,18 +232,21 @@ bool Movie::processSysEvent(Common::Event &event) {
 				if (g_system->getEventManager()->getButtonState() == 0)
 					return true;
 
+			// Queue as input events: a mouse move seen while Lingo is mid-handler
+			// (execute() polls events every 100 ops) must not run handlers nested
+			// inside it, or the nested execute() also runs the outer frames.
 			if (spriteId > 0) {
 				if (spriteId != _lastEnteredChannelId) {
 					if (_lastEnteredChannelId) {
-						processEvent(kEventMouseLeave, _lastEnteredChannelId);
+						processInputEvent(kEventMouseLeave, _lastEnteredChannelId, pos);
 					}
 
 					_lastEnteredChannelId = spriteId;
-					processEvent(kEventMouseEnter, spriteId);
+					processInputEvent(kEventMouseEnter, spriteId, pos);
 				}
 			} else {
 				if (_lastEnteredChannelId) {
-					processEvent(kEventMouseLeave, _lastEnteredChannelId);
+					processInputEvent(kEventMouseLeave, _lastEnteredChannelId, pos);
 					_lastEnteredChannelId = 0;
 				}
 			}
diff --git a/engines/director/score.cpp b/engines/director/score.cpp
index 920a981..1e2de3e 100644
--- a/engines/director/score.cpp
+++ b/engines/director/score.cpp
@@ -599,6 +599,8 @@ void Score::updateNextFrameTime() {
 			}
 		} else { // D6+
 			int16 tempoCuePoint = _currentFrame->_mainChannels.tempoCuePoint;
+			if (tempo == 248 || tempo < 246)
+				warning("Score::updateNextFrameTime(): D6 frame %d tempo %d cue %d (wait instruction)", getCurrentFrameNum(), tempo, tempoCuePoint);
 
 			if (tempo == 255) {
 				// Wait for sound channel 1
