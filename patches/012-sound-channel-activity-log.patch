Subject: [PATCH] 0012 sound channel activity log (dev B)

---
 engines/director/sound.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/engines/director/sound.cpp b/engines/director/sound.cpp
index 1f9ace0..a156e00 100644
--- a/engines/director/sound.cpp
+++ b/engines/director/sound.cpp
@@ -356,6 +356,9 @@ bool DirectorSound::isChannelActive(int soundChannel) {
 	if (!_mixer->isSoundHandleActive(_channels[soundChannel]->handle))
 		return false;
 
+	debugC(3, kDebugSound, "DirectorSound::isChannelActive(): channel %d active, elapsed %u ms, loopPtr %p",
+		soundChannel, _mixer->getSoundElapsedTime(_channels[soundChannel]->handle), (void *)_channels[soundChannel]->loopPtr);
+
 	// Looped sounds are considered to be inactive after the first play
 	// WORKAROUND HACK
 	if (_channels[soundChannel]->loopPtr != nullptr)
