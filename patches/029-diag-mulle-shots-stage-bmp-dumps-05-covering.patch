 engines/director/lingo/lingo-the.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/engines/director/lingo/lingo-the.cpp b/engines/director/lingo/lingo-the.cpp
index bbc50aa..8a427e8 100644
--- a/engines/director/lingo/lingo-the.cpp
+++ b/engines/director/lingo/lingo-the.cpp
@@ -1909,6 +1909,15 @@ void Lingo::setTheSprite(Datum &id1, int field, Datum &d) {
 				channel->setCast(targetMember);
 				// Ensure the new sprite, whether larger or smaller, appears correctly on the screen
 			}
+			if (id == 1 && movie->getMacName().hasPrefix("05")) {
+				Common::Rect bb = channel->getBbox();
+				warning("MULLEDIAG 05 sprite 1 now %dx%d bbox (%d,%d,%d,%d) stretch %d ink %d visible %d blend %d", sprite->_width, sprite->_height, bb.left, bb.top, bb.right, bb.bottom, sprite->_stretch, sprite->_ink, channel->_visible, sprite->_blendAmount);
+				for (uint c = 2; c < score->_channels.size(); c++) {
+					Channel *oc = score->_channels[c];
+					if (oc && oc->_sprite && oc->_sprite->_cast && oc->_visible && oc->getBbox().width() >= 500)
+						warning("MULLEDIAG 05 covering ch %d member %s %dx%d ink %d stretch %d type %d init %dx%d puppet %d", c, oc->_sprite->_castId.asString().c_str(), oc->getBbox().width(), oc->getBbox().height(), oc->_sprite->_ink, oc->_sprite->_stretch, oc->_sprite->_cast->_type, oc->_sprite->_cast->getInitialRect().width(), oc->_sprite->_cast->getInitialRect().height(), oc->_sprite->_puppet);
+				}
+			}
 		}
 		break;
 	case kTheCastNum:
